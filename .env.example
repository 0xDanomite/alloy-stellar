# Network the scripts and app target: testnet | mainnet
NETWORK=testnet

# stellar-cli identity names (created with `stellar keys generate` or `stellar keys add`).
# Keys stay in your local stellar config; nothing secret goes in this file.
ADMIN_IDENTITY=alloy-admin
MANAGER_IDENTITY=alloy-manager
INVESTOR_IDENTITY=alloy-investor
DEMO_ISSUER_IDENTITY=alloy-demo-issuer

# RPC endpoints
TESTNET_RPC_URL=https://soroban-testnet.stellar.org
MAINNET_RPC_URL=https://mainnet.sorobanrpc.com

# App (Vite)
VITE_NETWORK=testnet
VITE_RPC_URL=https://soroban-testnet.stellar.org
VITE_HORIZON_URL=https://horizon-testnet.stellar.org
